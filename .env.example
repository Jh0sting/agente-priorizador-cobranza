# Copia este archivo como .env y reemplaza el valor de ejemplo.
# Nunca publiques el archivo .env ni tu llave real.
# Crea tu llave gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=REEMPLAZA_CON_TU_LLAVE
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Opcional. Si se omite, se usa gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
